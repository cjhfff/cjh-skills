#!/bin/zsh
# claude-official - 通过 Anthropic 官方 API 调用 Claude Code（消耗订阅额度）
# 用法: claude-official "prompt"
# 用途: 重要决策、架构设计、代码审查

if [ -z "$1" ]; then
  echo "用法: claude-official \"prompt\""
  exit 1
fi

exec env -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_BASE_URL -u ANTHROPIC_MODEL -u ANTHROPIC_API_KEY \
  /Users/yangyue/.local/bin/claude -p --dangerously-skip-permissions "$@"
